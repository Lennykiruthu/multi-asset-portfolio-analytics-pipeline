FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir --root-user-action=ignore \
    streamlit \
    pandas \
    yfinance \
    sqlalchemy \
    psycopg2-binary \
    python-dotenv \
    plotly

COPY streamlit/auth.py .
COPY streamlit/ledger-ui.py .

EXPOSE 8501

CMD ["streamlit", "run", "ledger-ui.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--server.headless=true"]